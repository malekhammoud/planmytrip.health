# Clerk application. The publishable key is safe for the browser; the secret key is
# server-only. Never commit a real value. Both are required to sign in and save trips.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Same-origin Clerk Frontend API proxy. The production Clerk domain must use the same
# proxy URL, for example https://planmytrip.health/__clerk.
NEXT_PUBLIC_CLERK_PROXY_URL=/__clerk

# TinyFish Web Agent API key. Required for live swarm runs.
# Never commit a real key. The route returns a missing_api_key error per worker when unset.
TINYFISH_API_KEY=

# Set to 1 to ask TinyFish for a run recording and archive it locally. Cached
# verification replays the recordings from an authenticated same-origin route.
TINYFISH_RECORDING=
# Directory for archived recordings. Defaults to $HOME/recordings in production and
# .next/cache/recordings elsewhere. Must be writable by the app user.
PLANMYTRIP_RECORDINGS_DIR=

# Planner and verification cache. A cached destination replays in about a second;
# uncached destinations run live and seed the cache. Leave enabled in production.
PLANMYTRIP_CACHE=
# Optional in-process cache override. Production enables the memory tier automatically
# when DATABASE_URL is set; tests set 1 to use it without a database.
PLANMYTRIP_CACHE_MEMORY=

# Set to 1 in local development to stream mock agent events without a key.
# Ignored when NODE_ENV=production. Every mock payload carries mock: true.
SWARM_MOCK=

# OpenCode concierge team. With no URL, the app discovers or starts the local
# OpenCode service. Set a URL to use a dedicated service instead.
OPENCODE_SERVER_URL=
OPENCODE_SERVER_USERNAME=
OPENCODE_SERVER_PASSWORD=
# Optional model in provider/model form. For OpenCode Go, use
# opencode-go/deepseek-v4.1-flash after installing a Go credential in the service.
OPENCODE_MODEL=
OPENCODE_MODEL_VARIANT=

# Set to 1 in local development to script the concierge team without OpenCode.
# Ignored when NODE_ENV=production. Every planner payload carries mock: true.
AGENT_MOCK=

# Map tiles. Defaults to OpenStreetMap; set a licensed tile endpoint for production.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# Optional geocoding endpoint. Defaults to the public Nominatim service with a
# one-request-per-second limit. Set a paid endpoint for production volume.
NOMINATIM_URL=
NOMINATIM_USER_AGENT=
# Optional GeoJSON fallback geocoder used when Nominatim returns no point.
# Production currently uses https://photon.komoot.io/api/; confirm its terms.
GEOCODER_FALLBACK_URL=

# PostgreSQL for anonymous trip dossiers, outcomes, and model runs.
# Use separate databases for production, development, and tests.
DATABASE_URL=
# Set true for a TLS provider. Certificates are validated; add a private CA through
# NODE_EXTRA_CA_CERTS instead of disabling verification.
DATABASE_SSL=false

# Set to 1 in local development to capture mock planner and swarm runs.
# Ignored for real runs. Every captured dossier still requires explicit consent.
PLANMYTRIP_CAPTURE_MOCK=
